    {
      "name": "buy",
      "item": [
        {
          "name": "merchants",
          "item": [
            {
              "name": "List the merchants /buy can place at",
              "id": "a21a6140-74d3-4459-9efb-3bb71ba96da1",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bearerToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/buy/merchants",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "buy",
                    "merchants"
                  ]
                },
                "description": "The live catalogue for rail selection: every merchant id /buy accepts, its display name, and whether this user still needs to link an account there. Same bearer scoping as POST /buy. Merchant ids are the public ids /buy uses in `placements[].merchant` and `unmatched[].merchant` (`retail` covers Amazon, Walmart, Target, Best Buy, Home Depot, Lowe's, Macy's, Wayfair, Staples, Kohl's and B&H Photo)."
              },
              "response": [
                {
                  "id": "b9a381c5-cdf1-418f-a233-26b74dd32e22",
                  "name": "The catalogue.",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: bearer",
                        "key": "Authorization",
                        "value": "Bearer <token>"
