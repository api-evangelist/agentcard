        {
          "name": "conversations",
          "item": [
            {
              "name": "{id}",
              "item": [
                {
                  "name": "Read a purchase conversation",
                  "id": "d8795df9-f49e-4991-b8bb-cfabf02dfbcb",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "bearer",
                      "bearer": [
                        {
                          "key": "token",
                          "value": "{{bearerToken}}",
                          "type": "string"
                        }
                      ]
                    },
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/buy/conversations/:id",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "buy",
                        "conversations",
                        ":id"
                      ],
                      "variable": [
                        {
                          "id": "b0037a99-a607-43a4-adb1-004ccb47c161",
                          "key": "id",
                          "value": "<string>",
                          "description": "(Required) The conversation_id returned by POST /buy."
                        }
                      ]
                    },
                    "description": "The server's view of a /buy conversation, for a confirm whose response never arrived: whether a turn is still running, the last checkout attempt (any outcome, with its code and approval link), and every order the conversation placed, read from the ledger. Same bearer scoping as POST /buy."
                  },
                  "response": [
                    {
                      "id": "2668f9e0-d4ce-4494-966f-3a309cbe4c6f",
                      "name": "The conversation.",
                      "originalRequest": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          },
                          {
                            "description": "Added as a part of security scheme: bearer",
                            "key": "Authorization",
                            "value": "Bearer <token>"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/buy/conversations/:id",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "buy",
                            "conversations",
                            ":id"
                          ],
                          "variable": [
                            {
                              "key": "id"
                            }
                          ]
                        }
                      },
                      "status": "OK",
                      "code": 200,
                      "_postman_previewlanguage": "json",
                      "header": [
                        {
                          "key": "Content-Type",
                          "value": "application/json"
                        }
                      ],
                      "cookie": [],
                      "responseTime": null,
                      "body": "{\n  \"conversation_id\": \"<string>\",\n  \"status\": \"closed\",\n  \"turn_in_progress\": \"<boolean>\",\n  \"last_checkout\": null,\n  \"orders\": [\n    {\n      \"order_id\": \"<string>\",\n      \"merchant\": \"<string>\",\n      \"merchant_name\": \"<string>\",\n      \"status\": \"settled\",\n      \"total_cents\": \"<integer>\",\n      \"payment_source\": null,\n      \"placed_at\": \"<string,null-date-time>\",\n      \"merchant_total_cents\": \"<integer,null>\",\n      \"merchant_currency\": \"<string,null>\"\n    },\n    {\n      \"order_id\": \"<string>\",\n      \"merchant\": \"<string>\",\n      \"merchant_name\": \"<string>\",\n      \"status\": \"confirming\",\n      \"total_cents\": \"<integer>\",\n      \"payment_source\": {\n        \"source\": \"balance\",\n        \"brand\": \"<string,null>\",\n        \"last4\": \"<string,null>\"\n      },\n      \"placed_at\": \"<string,null-date-time>\",\n      \"merchant_total_cents\": \"<integer,null>\",\n      \"merchant_currency\": \"<string,null>\"\n    }\n  ],\n  \"carts\": [],\n  \"unmatched\": [],\n  \"created_at\": \"<dateTime>\",\n  \"updated_at\": \"<dateTime>\"\n}",
