  "item": [
    {
      "id": "c6f343e9-68f3-420b-8868-afe5dc5d9ecb",
      "name": "Withdrawals",
      "description": {
        "content": "Move money out of a connected user's wallet — to a saved bank account or a crypto address on Base. Transfers are processed manually by the Agentcard team, usually within 1-3 business days.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "59013f5e-7ba1-4b1e-a290-858e4fe25da3",
          "name": "Save a bank destination",
          "request": {
            "name": "Save a bank destination",
            "description": {
              "content": "Saves a bank account the user can withdraw to. `ach` needs `routing_number`, `account_number`, and `account_type`; `international_wire` needs `iban` and `swift_code`. Some countries need extra fields via `country_specific` (for example `ifsc`, `clabe`, `bsb`); the validation error names any missing key. A user can hold up to 25 active destinations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "wallet",
                "withdrawal-recipients"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"<string>\",\n  \"type\": \"<string>\",\n  \"beneficiary_name\": \"<string>\",\n  \"country_code\": \"<string>\",\n  \"nickname\": \"<string>\",\n  \"email\": \"<email>\",\n  \"routing_number\": \"<string>\",\n  \"account_number\": \"<string>\",\n  \"account_type\": \"<string>\",\n  \"iban\": \"<string>\",\n  \"swift_code\": \"<string>\",\n  \"bank_name\": \"<string>\",\n  \"address_line1\": \"<string>\",\n  \"address_line2\": \"<string>\",\n  \"city\": \"<string>\",\n  \"region\": \"<string>\",\n  \"postal_code\": \"<string>\",\n  \"country_specific\": {\n    \"key_0\": 9413,\n    \"key_1\": 8388.925674432001\n  }\n}",
