{
  "info": {
    "_postman_id": "1e341f20-4ee4-4082-b05e-43b877b1440c",
    "name": "Agentcard Authentication API",
    "description": "The Agentcard v2 API \u2014 connect your users and verify their identity from your own backend. Every call is authenticated with a platform access token minted from your `client_id` + `client_secret`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:36:36.000Z",
    "updatedAt": "2026-10-22T01:36:36.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-1e341f20-4ee4-4082-b05e-43b877b1440c"
  },
