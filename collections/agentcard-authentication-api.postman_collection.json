{
  "item": [
    {
      "id": "95dd60c2-4814-4ac1-bc42-bf72499c9c33",
      "name": "Authentication",
      "description": {
        "content": "Exchange your client credentials for a platform access token, and introspect what a token acts as.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "962b3660-f423-4932-9abc-2e57b7957d78",
          "name": "Create an access token",
          "request": {
            "name": "Create an access token",
            "description": {
              "content": "Exchanges your `client_id` + `client_secret` for a platform access token (OAuth2 client credentials, RFC 6749 §4.4). The token lives one hour — when it expires, exchange again; there are no refresh tokens on this grant.\n\nGet your credentials in the Agentcard dashboard under **Organization → Developer → Credentials**. A sandbox client mints tokens that act in sandbox; a production client acts in production.\n\nYou can also send the credentials as HTTP Basic (`Authorization: Basic base64(client_id:client_secret)`) instead of in the form body.\n\nThis endpoint is rate limited to 30 requests per 5 minutes per IP — cache the token and reuse it until it expires.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) Always `client_credentials`."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Your client id, from the dashboard."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) Your client secret (`acs_…`), shown once when you create the client."
                }
              ]
            }
          },
          "response": [
            {
              "id": "46bcdf37-5af3-4beb-95d7-5e855ec6a75c",
              "name": "The token to send as `Authorization: Bearer <access_token>` on every other call.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Always `client_credentials`.",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Your client id, from the dashboard.",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Your client secret (`acs_…`), shown once when you create the client.",
                        "type": "text/plain"
                      },
                      "key": "client_secret",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs…\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3600,\n  \"scope\": \"api\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
