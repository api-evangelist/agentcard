  "item": [
    {
      "id": "61edbd00-fc5f-4691-aaa0-ce7db8e7d204",
      "name": "Connect",
      "description": {
        "content": "Connect a user to your platform: send a one-time code, verify it, record consent, and keep the connection alive.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ee59d939-8e89-478e-a44f-3078807114a4",
          "name": "Send a code",
          "request": {
            "name": "Send a code",
            "description": {
              "content": "Sends a one-time code to the user by email or phone. Provide **exactly one** of `email` or `phone`. Codes are valid for 10 minutes.\n\nIf you've designed a connect email in your dashboard, we send that branded email; otherwise we send a default one.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "connect",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"phone\": \"<string>\",\n  \"external_user_id\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
